# Copy this to .env.local and fill in values (never commit .env.local)
# Equivalent to quml-player's src/environments/environment.ts

# Sunbird instance base URL (same as environment.baseUrl in quml-player)
VITE_BASE_URL=https://sandbox.sunbirded.org

# Auth token for content API calls (if the instance requires auth)
# Format: Bearer eyJhbGci...
VITE_AUTH_TOKEN=

# Default content ID to load in the dev harness
VITE_CONTENT_ID=do_214465410871590912129

# Default language (BCP-47 code: en, ar, hi, ta, fr, pt)
VITE_LANGUAGE=en

# Optional: override telemetry endpoint (default: VITE_BASE_URL/data/v3/telemetry)
VITE_TELEMETRY_URL=
VITE_CDN_PROXY=
